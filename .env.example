COMPOSE_PROJECT_NAME=monitoring

# Bind services to both the NetBird and local LAN interfaces.
MONITORING_BIND_IP=100.109.138.94
LOCAL_BIND_IP=192.168.6.135

PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
LOKI_PORT=3100

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_strong_random_password

PROMETHEUS_IMAGE=prom/prometheus:v3.14.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.34.0
GRAFANA_IMAGE=grafana/grafana:13.0.7
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.12.1
LOKI_IMAGE=grafana/loki:3.6.15
ALLOY_IMAGE=grafana/alloy:v1.18.1
CADVISOR_IMAGE=ghcr.io/google/cadvisor:v0.60.5
